# Copy to .env for local runs. Never commit .env.

# Subscription mode (ai.auth: subscription): token from `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=

# API mode (ai.auth: api_key): Claude API key with web_search / web_fetch
ANTHROPIC_API_KEY=

# OpenRouteService (isochrone + matrix), free key from https://account.heigit.org
ORS_API_KEY=

# Optional overrides (defaults shown); e.g. a self-hosted ORS instance
# ORS_BASE_URL=https://api.heigit.org/openrouteservice
# OVERPASS_URL=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter

# Optional: Instagram business accounts (docs/OPERATIONS.md, "Instagram setup")
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
