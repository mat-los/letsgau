# Copy to .env for local runs. Never commit .env.

# Subscription mode (ai.auth: subscription): token from `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=

# API mode (ai.auth: api_key): Claude API key with web_search / web_fetch
ANTHROPIC_API_KEY=

# OpenRouteService (isochrone + matrix), free key from openrouteservice.org
ORS_API_KEY=
